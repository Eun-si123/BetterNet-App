#!/bin/sh
# Opt-in only: git config --local core.hooksPath .githooks
# Scan history (including commits deleted from the working tree) before pushing.
set -eu
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Gitleaks is required by the opted-in pre-push hook; install it or remove the local core.hooksPath setting." >&2
  exit 1
fi
repository_root=$(git rev-parse --show-toplevel)
gitleaks git "$repository_root" --log-opts="--all" --redact=100 --no-banner
